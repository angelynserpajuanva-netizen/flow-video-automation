# Copy this file to .env and fill in your keys. Never share or commit .env.

# Tella → Settings → API → Generate key (starts with tella_pk_)
TELLA_API_KEY=

# Output settings for the final video
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# Music bed level under your voice (0.0–1.0) and target loudness (YouTube ≈ -14 LUFS)
MUSIC_VOLUME=0.25
TARGET_LUFS=-14
